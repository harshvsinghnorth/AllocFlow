# Copy to server/.env and adjust.

NODE_ENV=development
PORT=4000

# Driver is selected from this value:
#   file:./data/allocflow          -> embedded PGlite (zero setup, development)
#   postgresql://user:pass@host/db -> a real PostgreSQL server (production)
DATABASE_URL=file:./data/allocflow

# REQUIRED in production: at least 32 characters, unique per deployment.
# Boot fails rather than starting with the development fallback.
JWT_SECRET=allocflow-development-secret-do-not-use-in-production
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Apply migrations and seed demo data on boot.
AUTO_MIGRATE=true
AUTO_SEED=true

# Connection pool size, PostgreSQL driver only.
DB_POOL_MAX=10
